{
	"name": "shadcn-registry-docs-template",
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@shadcn-registry-docs-template/config": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"turbo": "^2.10.10",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"deps": "bunx taze@latest -rw",
		"check-types": "turbo check-types",
		"check": "biome check --write .",
		"registry:build": "bun --cwd apps/docs ./src/scripts/build-registry.mts",
		"primitive:add": "bun --cwd apps/docs ./src/scripts/add-primitive.mts",
		"primitive:sync": "bun --cwd apps/docs ./src/scripts/sync-primitive.mts",
		"add": "bun --cwd apps/docs ./src/scripts/add-primitive.mts",
		"prepare": "husky || true"
	},
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
